rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invitaciones: invitaciones/{codigo} -> { grupoId }.
    // Conocer el código es lo que da acceso: se lee por id, pero no se pueden listar.
    match /invitaciones/{codigo} {
      allow get: if request.auth != null;
      allow list: if false;
      // Solo un miembro del grupo puede registrar su código, y debe ser el código real del grupo.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['grupoId'])
        && get(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId)).data.codigoInvitacion == codigo
        && request.auth.uid in get(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId)).data.miembrosUids;
      allow update, delete: if false;
    }

    // Grupos: solo accesibles por usuarios autenticados.
    match /grupos/{grupoId} {

      // Ayudante: ¿el usuario actual es miembro del grupo?
      function esMiembro() {
        return request.auth != null
          && request.auth.uid in resource.data.miembrosUids;
      }

      // Leer: solo los miembros del grupo.
      allow read: if esMiembro();

      // Crear: cualquier usuario autenticado, siempre que se incluya a sí mismo como miembro.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.miembrosUids
        && request.resource.data.creadoPor == request.auth.uid;

      // Actualizar: debe ser miembro actual, o bien unirse por código
      // (el documento resultante debe contener su uid en miembrosUids).
      allow update: if request.auth != null
        && (
          request.auth.uid in resource.data.miembrosUids
          || request.auth.uid in request.resource.data.miembrosUids
        );

      // Borrar: solo un miembro del grupo.
      allow delete: if esMiembro();

      // Subcolecciones (gastos y mensajes): solo miembros del grupo padre.
      function esMiembroDelGrupoPadre() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembrosUids;
      }

      match /gastos/{gastoId} {
        allow read, write: if esMiembroDelGrupoPadre();
      }

      match /mensajes/{mensajeId} {
        allow read: if esMiembroDelGrupoPadre();
        // Crear mensaje: debe ser miembro y el autor debe ser él mismo.
        allow create: if esMiembroDelGrupoPadre()
          && request.resource.data.autorUid == request.auth.uid;
        // Los mensajes no se editan. Borrar: su autor, o el último miembro del grupo
        // (para poder eliminar el grupo completo sin dejar mensajes huérfanos).
        allow delete: if request.auth != null
          && (
            resource.data.autorUid == request.auth.uid
            || (
              esMiembroDelGrupoPadre()
              && get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembrosUids.size() == 1
            )
          );
      }
    }
  }
}
